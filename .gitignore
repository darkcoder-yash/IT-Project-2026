# ==========================================
# Personal Finance Intelligence System .gitignore
# ==========================================

# Virtual Environments
venv/
.venv/
backend/venv/
ENV/
env/
*.env

# Python / Pytest Cache & Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.sqlite3

# SQLite Database (generated at runtime / seed data will auto-generate)
*.db
backend/finance.db

# Node / Frontend Artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS & IDE metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
